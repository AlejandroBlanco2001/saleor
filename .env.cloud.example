# monolith / order-service profiles, pointed at AWS.
# Copy to `.env.cloud` (gitignored) and fill in real values — never commit
# real credentials/endpoints. Run with e.g.:
#   ENV_FILE=.env.cloud docker compose --profile monolith up
#   ENV_FILE=.env.cloud docker compose --profile order-service up
#
# Step 9's `terraform output` prints a ready-to-paste snippet for the
# `monolith`-side values once RDS/SQS/order-service are provisioned — or run
# `scripts/cloud_dev.py wire` (also `.sh`/`.bat`) to generate this file
# directly from terraform output + this shell's AWS creds.

SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# --- monolith profile ---
DATABASE_URL=postgres://<user>:<password>@<rds-endpoint>:5432/saleor
CELERY_BROKER_URL=sqs://
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS Academy Learner Lab issues temporary STS credentials -- these need a
# session token too, not just key/secret.
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
ORDER_SERVICE_URL=http://<order-service-ec2-public-ip>:8000
ORDER_SERVICE_SHARED_SECRET=<matches order-service's>

# --- order-service profile ---
ASYNC_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<rds-endpoint>:5432/saleor
# No stable address for a laptop-hosted monolith — use a tunnel (ngrok etc.)
# or accept the webhook round-trip is best-effort in this mode. See
# plans/steps/07-docker-compose.md's "Known gap" note.
DJANGO_EVENTS_URL=http://<tunnel-or-known-reachable-host>:8000/order-service/events/
