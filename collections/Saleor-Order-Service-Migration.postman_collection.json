    {
      "name": "04 - Order Queries (query facade, step 5)",
      "item": [
        {
          "name": "order(id) - found, full field parity",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('no graphql errors', () => pm.expect(body.errors).to.be.undefined);",
                  "const order = body.data.order;",
                  "pm.test('order found', () => pm.expect(order).to.not.be.null);",
                  "['id','token','status','created','lines','shippingAddress','billingAddress','total','shippingPrice','weight'].forEach((field) => {",
                  "  pm.test(`field present: ${field}`, () => pm.expect(order).to.have.property(field));",
                  "});",
                  "pm.test('id matches the created order', () => pm.expect(order.id).to.eql(pm.collectionVariables.get('order_gid')));",
                  "pm.test('at least one line, quantity matches checkout', () => {",
                  "  pm.expect(order.lines.length).to.be.above(0);",
                  "  pm.expect(order.lines[0].quantity).to.eql(1);",
                  "});",
                  "pm.collectionVariables.set('order_status_from_graphql', order.status);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "JWT {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\":\"query ($id: ID!) { order(id: $id) { id token status created customerNote languageCode trackingClientId discountName translatedDiscountName displayGrossPrices shippingMethodName shippingPrice { gross { amount currency } net { amount currency } } discount { amount currency } total { gross { amount currency } net { amount currency } } billingAddress { city countryArea } shippingAddress { city countryArea } lines { productName quantity } weight { value unit } } }\",\"variables\":{\"id\":\"{{order_gid}}\"}}"
            },
            "url": {
              "raw": "{{base_url}}/graphql/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
