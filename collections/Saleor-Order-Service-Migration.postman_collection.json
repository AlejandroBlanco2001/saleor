    {
      "name": "05 - order-service direct (microservice only, post-modernization)",
      "description": "Talks to order-service's FastAPI REST API directly (bypassing GraphQL) to prove the facade in folder 04 is actually backed by this service, not a leftover ORM path. Every request here is skipped automatically when `order_service_enabled` != \"true\" (set that in the pre-modernization environment, or run this whole folder with the post-modernization one), so the same collection is safe to run against either checkout without editing requests.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.variables.get('order_service_enabled') !== 'true') {",
              "  console.log('order_service_enabled != true -- skipping order-service direct checks (expected on the pre-modernization monolith)');",
              "  pm.execution.skipRequest();",
              "}"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "GET /health",
